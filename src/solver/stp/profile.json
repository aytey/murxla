{
  "theories": {
    "include": [
      "THEORY_ARRAY",
      "THEORY_BOOL",
      "THEORY_BV"
    ]
  },

  "operators": {
    "exclude": [
      "OP_CONST_ARRAY"
    ],
    "sort-restrictions": {
      "OP_DISTINCT": [
        "SORT_ARRAY"
      ],
      "OP_EQUAL": [
        "SORT_ARRAY"
      ],
      "OP_ITE": [
        "SORT_ARRAY"
      ]
    }
  },

  "sorts": {
    "array-index": {
      "exclude": [
        "SORT_BOOL",
        "SORT_ARRAY",
        "SORT_FUN"
      ]
    },

    "array-element": {
      "exclude": [
        "SORT_BOOL",
        "SORT_ARRAY",
        "SORT_FUN"
      ]
    },

    "get-value": {
      "exclude": [
        "SORT_ARRAY"
      ]
    }
  }
}
